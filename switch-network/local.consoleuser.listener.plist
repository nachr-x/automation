<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.consoleuser.listener</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/switch-network/console-user-listener</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/consoleuser-listener.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/consoleuser-listener.err</string>
</dict>
</plist>
